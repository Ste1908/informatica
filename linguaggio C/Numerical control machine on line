#include <stdio.h>
int main()
{
int home;
int pos;
char comand[51];
char track[26];
printf(" set home: ");
scanf("%d", &home);
pos=home;
for(int i=0;i<26;i++) track[i]='#';
track[26]='\0';
printf("insert program: ");
scanf("%s", comand);
for (int i =0; comand[i]!='\0';i++){
    if(comand[i]=='>') pos+=1;
    if(comand[i]=='<') pos-=1;
    if(comand[i]=='P') track[pos]='O';
    if(comand[i]=='H') pos=home;
    if(pos==-1||pos==26) {
        printf("emergency stop: out of bounds");
        return 0;
    }
}
 printf("machining sequence completed\nproduct: %s", track);
}
